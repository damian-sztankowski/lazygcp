# Charmbracelet VHS Tape for recording lazygcp
Output assets/lazygcp-demo.gif
Set FontSize 14
Set Width 1440
Set Height 860
Set Theme "Catppuccin Mocha"

Type "lazygcp --demo"
Enter
Sleep 2.5s

# Module 2: Live Project IAM & Blast Radius
Type "2"
Sleep 1.5s
Type "z"
Sleep 2.5s

# Module 3: GKE & Compute VMs + SSH / IAP Mode Selector
Type "3"
Sleep 1.5s
Type "j"
Sleep 1s
Type "s"
Sleep 2.5s
Type "2"
Sleep 2.5s
Escape
Sleep 1s
Type "t"
Sleep 2.5s

# Module 8: FinOps & Cloud Billing
Type "8"
Sleep 2.5s

# Module 9: Cloud Audit Time-Machine
Type "9"
Sleep 2.5s

Type "q"
